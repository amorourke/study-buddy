PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
# Leave both blank to use the local file data/app.db. Set them to use a Turso database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Password given to every mock student created by `npm run db:mock`.
# Must be 8+ characters with a lowercase letter, an uppercase letter and one of ! * . ?
MOCK_PASSWORD=Password1!
